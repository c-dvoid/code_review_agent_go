# Configuration for the self-hosted server (go run ./cmd/server or Docker).
# Copy this file to .env and fill in the blanks. The GitHub Action does not
# read this file; it is configured with inputs in your workflow instead.
#
# Real environment variables take precedence over .env. Commented-out lines
# show the default value.

# --- Server ---
HTTP_ADDR=:8080
LOG_LEVEL=info                    # debug | info | warn | error
REQUEST_TIMEOUT=180s
SHUTDOWN_TIMEOUT=30s
# MAX_BODY_BYTES=2097152
# Protects POST /api/v1/review with "Authorization: Bearer <API_KEY>".
# Set it whenever the server is reachable from the internet (e.g. via ngrok).
# API_KEY=

# --- LLM provider: anthropic | openai | ollama | mock ---
LLM_PROVIDER=openai

# OpenAI or any OpenAI-compatible API. This example uses OpenRouter;
# for OpenAI itself use https://api.openai.com/v1.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-6-luna

# Anthropic Claude (set LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=high           # low | medium | high | xhigh | max
# ANTHROPIC_FALLBACKS=true        # set to false for models other than claude-opus-5-5, claude-opus-5, claude-fable-5-1, claude-sonnet-5-5
# ANTHROPIC_MAX_RETRIES=2
# ANTHROPIC_BASE_URL=

# Ollama, local and free (set LLM_PROVIDER=ollama)
# OLLAMA_MODEL=qwen2.5-coder
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Review ---
REVIEW_MAX_INPUT_BYTES=400000     # larger diffs are rejected, never truncated
REVIEW_MAX_TOKENS=16000
# For PR reviews, also send the full new version of each changed file.
# REVIEW_CONTEXT_FILES=true
# REVIEW_MAX_CONTEXT_FILE_BYTES=100000

# --- GitHub ---
# Fine-grained token: Contents read, Pull requests read, Issues read/write.
GITHUB_TOKEN=
# Same value as the "Secret" field of the repository webhook.
GITHUB_WEBHOOK_SECRET=
GITHUB_POST_COMMENTS=true
# GITHUB_API_BASE_URL=https://api.github.com   # change for GitHub Enterprise

# --- Webhook processing ---
WEBHOOK_ASYNC=true                # reply 202 at once, review in the background
WEBHOOK_MAX_CONCURRENCY=4
WEBHOOK_MAX_QUEUE=100
WEBHOOK_JOB_TIMEOUT=10m
