# --- Server ---
HTTP_ADDR=:8080
LOG_LEVEL=info
REQUEST_TIMEOUT=180s
SHUTDOWN_TIMEOUT=30s
# API_KEY=change-me

# --- LLM: anthropic | openai | ollama | mock ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high
ANTHROPIC_FALLBACKS=true

# OPENAI_API_KEY=
# OPENAI_MODEL=
# OLLAMA_MODEL=
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Review limits ---
REVIEW_MAX_INPUT_BYTES=400000
REVIEW_MAX_TOKENS=16000

# --- GitHub ---
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_POST_COMMENTS=true

# --- Webhook processing ---
WEBHOOK_ASYNC=true
WEBHOOK_MAX_CONCURRENCY=4
WEBHOOK_MAX_QUEUE=100
WEBHOOK_JOB_TIMEOUT=10m
